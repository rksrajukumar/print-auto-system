[Unit]
Description=Auto Print Server
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/opt/auto-print-server/server
EnvironmentFile=/opt/auto-print-server/server/.env
ExecStart=/usr/bin/node /opt/auto-print-server/server/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
